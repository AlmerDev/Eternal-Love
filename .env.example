# =========================================================================
# ETERNAL LOVE (CIYAN & DAFFA) - ENVIRONMENT CONFIGURATION
# =========================================================================
# Salin file ini menjadi .env:
# cp .env.example .env

# --- SUPABASE DATABASE & STORAGE (OPSIONAL) ---
# Jika kamu ingin data tersimpan online di cloud Supabase:
# Dapatkan Project URL dan anon public key dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Catatan:
# GEMINI_API_KEY dan APP_URL TIDAK PERLU DIISI untuk menjalankan web ini.
# Website ini adalah scrapbook romantis murni tanpa ketergantungan AI eksternal.
